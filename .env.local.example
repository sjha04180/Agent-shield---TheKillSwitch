# =============================================================
# The Kill Switch (AgentShield) — Environment Variables Template
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# ─── NextAuth / Auth.js ─────────────────────────────────────
# Required: the public URL of your deployment
NEXTAUTH_URL=http://localhost:3000

# Required: a strong random secret (run: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-here

# ─── MongoDB Atlas ───────────────────────────────────────────
# Get this from your Atlas project → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agentshield?retryWrites=true&w=majority

# ─── Google Gemini AI ────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Lyzr AI Platform Credentials ────────────────────────────
# Get from your Lyzr Studio Profile Dashboard
LYZR_API_KEY=your_lyzr_platform_api_key
LYZR_ENDPOINT=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_USER_ID=your_lyzr_registered_email
LYZR_CLOUD_AGENT_ID=your_deployed_cloud_billing_agent_id
LYZR_TREASURY_AGENT_ID=your_deployed_treasury_agent_id

# ─── Blockchain / Hardhat ────────────────────────────────────
# Sepolia testnet RPC (Alchemy or Infura recommended)
# Public fallback: https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key

# Deployer wallet private key (used ONLY for contract deployment scripts)
# NEVER use a wallet with real mainnet funds here
PRIVATE_KEY=0xabc123...your-private-key-here
MASTER_WALLET_PRIVATE_KEY=0xabc123...your-private-key-here

# ─── Deployed Contract Addresses ────────────────────────────
# Fill these in after running: npm run hardhat:compile && npx hardhat run scripts/deploy.ts
NEXT_PUBLIC_KILL_SWITCH_ADDRESS=
NEXT_PUBLIC_TRANSACTION_EXECUTOR_ADDRESS=
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=
NEXT_PUBLIC_POLICY_MANAGER_ADDRESS=
